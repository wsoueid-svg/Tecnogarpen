# mock (default) uses the built-in directory. entra reserves Microsoft Entra for a later increment.
AUTH_MODE=mock

# Required only when AUTH_MODE=entra. Leave empty in the mock setup. Never commit real secrets.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Signs the demo session cookie. Replace this anywhere the app is shared.
SESSION_SECRET=replace-with-a-long-random-string

# local writes .data/store.json. supabase targets the Frankfurt project (eu-central-1).
DATA_BACKEND=local
# Optional override for the JSON file. Relative paths resolve from the project root.
# DATA_FILE=.data/store.json

# Required only when DATA_BACKEND=supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWT secret of the Supabase project. The server signs a short-lived token whose sub is app_user.id
# so Postgres auth.uid() matches the mock directory. Never commit the real value.
SUPABASE_JWT_SECRET=
